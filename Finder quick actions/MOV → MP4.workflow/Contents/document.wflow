				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Запустить скрипт оболочки</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Инициализация счетчиков
success_count=0
fail_count=0
fail_list=""

# Путь к ffmpeg
FFMPEG=/opt/homebrew/bin/ffmpeg

# Временный лог
LOGFILE=$(mktemp)

# Цикл по выбранным файлам
for f in "$@"
do
    output="${f%.*}.mp4"
    
    # Конвертация
    $FFMPEG -i "$f" -c:v libx264 -c:a aac -b:v 2M -b:a 128k -movflags +faststart "$output" 2&gt;&gt;"$LOGFILE"
    exit_code=$?

    if [ $exit_code -eq 0 ]; then
        success_count=$((success_count+1))
    else
        fail_count=$((fail_count+1))
        last_error=$(tail -n 3 "$LOGFILE") # последние строки лога для ошибки
        fail_list="$fail_list\n$f : $last_error"
    fi
done

# Формируем сообщение для уведомления
if [ $fail_count -eq 0 ]; then
    message="✅ Конвертация завершена успешно!\nФайлов: $success_count"
else
    message="⚠️ Конвертация завершена с ошибками.\nУспешно: $success_count\nНеудачно: $fail_count\nОшибки:$fail_list"
fi

# Показываем системное уведомление
osascript -e "tell application \"System Events\" to display notification \"$message\" with title \"Конвертация MP4\""

# Удаляем временный лог
rm -f "$LOGFILE"
</string>
